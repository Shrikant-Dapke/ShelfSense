{
  "name": "shelfsense",
  "version": "0.1.0",
  "private": true,
  "description": "ShelfSense — Smarter Inventory. Less Waste. Better Distribution.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "pnpm --filter @shelfsense/server dev",
    "dev:client": "pnpm --filter @shelfsense/client dev",
    "build:server": "pnpm --filter @shelfsense/server build",
    "build:client": "pnpm --filter @shelfsense/client build",
    "test:server": "pnpm --filter @shelfsense/server test",
    "db:migrate": "pnpm --filter @shelfsense/server db:migrate",
    "db:seed": "pnpm --filter @shelfsense/server db:seed"
  }
}
