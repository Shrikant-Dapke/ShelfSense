# Server
PORT=4000
NODE_ENV=development

# Database (local PostgreSQL — Supabase URL goes here at deploy time)
DATABASE_URL=postgresql://postgres@localhost:5432/shelfsense?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_HOURS=8

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000

# Seeding (only used by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@shelfsense.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=ShelfSense Admin
